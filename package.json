{
  "name": "ar-dino",
  "version": "0.1.0",
  "private": true,
  "description": "WebXR (A-Frame) AR dinosaur: surface placement, walking, voice, touch gestures.",
  "scripts": {
    "vendor": "node tools/vendor.mjs",
    "test": "node --test",
    "check": "node tools/check-links.mjs",
    "serve": "python3 -m http.server 5500",
    "build": "node tools/build-dist.mjs",
    "cf:deploy": "npm run build && wrangler deploy",
    "cf:tunnel": "cloudflared tunnel --url http://localhost:5500"
  },
  "dependencies": {
    "aframe": "1.7.0"
  }
}
